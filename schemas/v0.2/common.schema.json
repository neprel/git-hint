{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hint:schema:v0.2:common",
  "title": "HINT v0.2 common definitions",
  "$defs": {
    "OpaqueId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "description": "128-bit opaque identifier, 32 lowercase hex characters."
    },
    "TraceId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "not": {
        "const": "00000000000000000000000000000000"
      },
      "description": "Trace-id in the W3C Trace Context format (all zeros is invalid), pseudonymized with the project key (hint-data 4.1); never the source trace-id."
    },
    "SpanId": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$",
      "not": {
        "const": "0000000000000000"
      },
      "description": "Span-id in the W3C Trace Context format (all zeros is invalid), pseudonymized with the project key (hint-data 4.1); never the source span-id."
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "Timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "description": "RFC 3339 time in UTC with the Z suffix."
    },
    "SemVer": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(alpha|beta|rc|dev)(\\.(0|[1-9][0-9]*))?)?$",
      "description": "Semantic version; a pre-release label is limited to alpha, beta, rc or dev and a number."
    },
    "SpecVersion": {
      "type": "string",
      "pattern": "^0\\.2\\.(0|[1-9][0-9]*)$",
      "description": "HINT specification version that this schema set validates."
    },
    "Unit": {
      "type": "string",
      "enum": [
        "bytes",
        "tokens",
        "count",
        "seconds",
        "lines",
        "ratio",
        "tasks"
      ]
    },
    "Metric": {
      "type": "string",
      "enum": [
        "model_tokens",
        "input_tokens",
        "output_tokens",
        "context_bytes",
        "context_tokens",
        "navigation_ops",
        "navigation_repeats",
        "boundary_crossings",
        "change_spread",
        "rework_edits",
        "validation_runs",
        "validation_failures",
        "tool_work_seconds",
        "task_elapsed_seconds",
        "success_rate",
        "coordination_waits",
        "handoffs"
      ]
    },
    "Precision": {
      "type": "string",
      "enum": [
        "exact",
        "derived",
        "inferred",
        "estimated"
      ]
    },
    "UnknownReason": {
      "type": "string",
      "enum": [
        "not_supported",
        "not_collected",
        "dropped",
        "redacted",
        "source_error",
        "not_applicable_yet"
      ]
    },
    "Coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "covered": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "covered",
        "total"
      ],
      "description": "Items with a known value (covered) out of all items (total; null if the total is unknown)."
    },
    "Bounds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lower": {
          "type": "number",
          "minimum": 0
        },
        "upper": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "lower",
        "upper"
      ],
      "description": "Range that contains the exact value; upper null means no finite upper bound. Bounds belong to quantities, so they are never negative."
    },
    "Quantity": {
      "description": "An absolute measured or derived amount; it is never negative. 'known' carries the exact value (0 is a real zero). 'unknown' carries no value. 'partial' carries the known part and its coverage, never a total. Signed differences exist only as forecast intervals and effect estimates.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unit": {
          "$ref": "#/$defs/Unit"
        },
        "state": {
          "type": "string",
          "enum": [
            "known",
            "unknown",
            "partial"
          ]
        },
        "value": {
          "type": "number",
          "minimum": 0
        },
        "known_part": {
          "type": "number",
          "minimum": 0
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "bounds": {
          "$ref": "#/$defs/Bounds"
        },
        "precision": {
          "$ref": "#/$defs/Precision"
        },
        "reason": {
          "$ref": "#/$defs/UnknownReason"
        },
        "method": {
          "type": "string",
          "enum": [
            "plugin_output_length",
            "hook_payload_length",
            "model_server_usage",
            "harness_usage",
            "otlp_attribute",
            "file_size",
            "byte_count_estimate",
            "sum_of_records",
            "count_of_records",
            "clock_difference",
            "git_diff",
            "scanner"
          ]
        }
      },
      "required": [
        "unit",
        "state"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "known"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "value",
              "precision"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "known_part"
                  ]
                },
                {
                  "required": [
                    "reason"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "unknown"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "reason"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "value"
                  ]
                },
                {
                  "required": [
                    "known_part"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "partial"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "known_part",
              "coverage",
              "precision",
              "reason"
            ],
            "not": {
              "required": [
                "value"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "unit": {
                "enum": [
                  "count",
                  "lines",
                  "tasks"
                ]
              }
            },
            "required": [
              "unit"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "integer"
              },
              "known_part": {
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "unit": {
                "const": "ratio"
              }
            },
            "required": [
              "unit"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "maximum": 1
              },
              "known_part": {
                "maximum": 1
              },
              "bounds": {
                "properties": {
                  "upper": {
                    "maximum": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "Interval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lower": {
          "type": "number"
        },
        "upper": {
          "type": "number"
        },
        "level": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        }
      },
      "required": [
        "lower",
        "upper",
        "level"
      ],
      "description": "Central interval with its probability level."
    },
    "NonNegativeInterval": {
      "allOf": [
        {
          "$ref": "#/$defs/Interval"
        },
        {
          "properties": {
            "lower": {
              "minimum": 0
            },
            "upper": {
              "minimum": 0
            }
          }
        }
      ],
      "description": "Interval of an absolute amount (a cost or a horizon); never negative."
    },
    "Probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "FieldName": {
      "type": "string",
      "enum": [
        "time.start",
        "time.end",
        "correlation.task_id",
        "correlation.session_id",
        "correlation.turn_id",
        "correlation.tool_call_id",
        "correlation.trace_id",
        "correlation.span_id",
        "correlation.parent_span_id",
        "correlation.parent_observation_id",
        "targets",
        "outcome.status",
        "outcome.exit_code",
        "size",
        "usage",
        "command_class",
        "mutation_attribution",
        "content_delivery",
        "coordination",
        "agent_version",
        "context"
      ]
    },
    "Agent": {
      "type": "string",
      "enum": [
        "opencode",
        "claude-code",
        "codex",
        "other",
        "none"
      ]
    },
    "RecordType": {
      "type": "string",
      "enum": [
        "Snapshot",
        "Entity",
        "Relation",
        "PolicyConstraint",
        "Change",
        "Observation",
        "Metric",
        "Plan",
        "Effect"
      ]
    },
    "MetricUnit": {
      "description": "Each metric has one fixed unit.",
      "allOf": [
        {
          "if": {
            "properties": {
              "metric": {
                "const": "model_tokens"
              }
            },
            "required": [
              "metric"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "tokens"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric": {
                "const": "input_tokens"
              }
            },
            "required": [
              "metric"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "tokens"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric": {
                "const": "output_tokens"
              }
            },
            "required": [
              "metric"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "tokens"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric": {
                "const": "context_bytes"
              }
            },
            "required": [
              "metric"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "bytes"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric": {
                "const": "context_tokens"
              }
            },
            "required": [
              "metric"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "tokens"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric": {
                "const": "navigation_ops"
              }
            },
            "required": [
              "metric"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "count"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric": {
                "const": "navigation_repeats"
              }
            },
            "required": [
              "metric"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "count"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric": {
                "const": "boundary_crossings"
              }
            },
            "required": [
              "metric"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "count"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric": {
                "const": "change_spread"
              }
            },
            "required": [
              "metric"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "count"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric": {
                "const": "rework_edits"
              }
            },
            "required": [
              "metric"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "count"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric": {
                "const": "validation_runs"
              }
            },
            "required": [
              "metric"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "count"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric": {
                "const": "validation_failures"
              }
            },
            "required": [
              "metric"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "count"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric": {
                "const": "tool_work_seconds"
              }
            },
            "required": [
              "metric"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "seconds"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric": {
                "const": "task_elapsed_seconds"
              }
            },
            "required": [
              "metric"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "seconds"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric": {
                "const": "success_rate"
              }
            },
            "required": [
              "metric"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "ratio"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric": {
                "const": "coordination_waits"
              }
            },
            "required": [
              "metric"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "count"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric": {
                "const": "handoffs"
              }
            },
            "required": [
              "metric"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "count"
              }
            }
          }
        }
      ]
    }
  }
}
