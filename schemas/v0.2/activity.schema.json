{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hint:schema:v0.2:activity",
  "title": "HINT v0.2 activity records",
  "$defs": {
    "Target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "$ref": "urn:hint:schema:v0.2:common#/$defs/OpaqueId"
        },
        "scope_id": {
          "$ref": "urn:hint:schema:v0.2:common#/$defs/OpaqueId"
        },
        "range": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start_line": {
              "type": "integer",
              "minimum": 1
            },
            "end_line": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "start_line",
            "end_line"
          ]
        }
      },
      "oneOf": [
        {
          "required": [
            "entity_id"
          ]
        },
        {
          "required": [
            "scope_id"
          ],
          "not": {
            "required": [
              "range"
            ]
          }
        }
      ]
    },
    "Observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "observation_id": {
          "$ref": "urn:hint:schema:v0.2:common#/$defs/OpaqueId"
        },
        "class": {
          "const": "observation"
        },
        "op": {
          "type": "string",
          "enum": [
            "SESSION",
            "TURN",
            "TOOL",
            "READ",
            "SEARCH",
            "DISCOVER",
            "EDIT_INTENT",
            "FILE_MUTATION",
            "EXECUTE",
            "TEST",
            "BUILD",
            "VALIDATION",
            "COMPACTION",
            "USAGE",
            "DELEGATE",
            "REQUEST",
            "RESPONSE",
            "WAIT",
            "ERROR",
            "UNKNOWN",
            "MODEL_CALL"
          ]
        },
        "ops_secondary": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "SESSION",
              "TURN",
              "TOOL",
              "READ",
              "SEARCH",
              "DISCOVER",
              "EDIT_INTENT",
              "FILE_MUTATION",
              "EXECUTE",
              "TEST",
              "BUILD",
              "VALIDATION",
              "COMPACTION",
              "USAGE",
              "DELEGATE",
              "REQUEST",
              "RESPONSE",
              "WAIT",
              "ERROR",
              "UNKNOWN"
            ]
          },
          "uniqueItems": true
        },
        "source": {
          "type": "string",
          "enum": [
            "otlp",
            "native_hook",
            "plugin",
            "log",
            "shell_parser",
            "watcher",
            "orchestrator",
            "transport"
          ]
        },
        "source_id": {
          "$ref": "urn:hint:schema:v0.2:common#/$defs/OpaqueId"
        },
        "precision": {
          "enum": [
            "exact",
            "derived",
            "inferred",
            "estimated",
            "unknown"
          ]
        },
        "time": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start": {
              "oneOf": [
                {
                  "$ref": "urn:hint:schema:v0.2:common#/$defs/Timestamp"
                },
                {
                  "type": "null"
                }
              ]
            },
            "end": {
              "oneOf": [
                {
                  "$ref": "urn:hint:schema:v0.2:common#/$defs/Timestamp"
                },
                {
                  "type": "null"
                }
              ]
            },
            "clock": {
              "type": "string",
              "enum": [
                "agent",
                "collector",
                "server",
                "unknown"
              ]
            },
            "clock_domain": {
              "$ref": "urn:hint:schema:v0.2:common#/$defs/OpaqueId"
            }
          },
          "required": [
            "start",
            "end",
            "clock"
          ]
        },
        "correlation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "task_id": {
              "$ref": "urn:hint:schema:v0.2:common#/$defs/OpaqueId"
            },
            "session_id": {
              "$ref": "urn:hint:schema:v0.2:common#/$defs/OpaqueId"
            },
            "turn_id": {
              "$ref": "urn:hint:schema:v0.2:common#/$defs/OpaqueId"
            },
            "tool_call_id": {
              "$ref": "urn:hint:schema:v0.2:common#/$defs/OpaqueId"
            },
            "trace_id": {
              "$ref": "urn:hint:schema:v0.2:common#/$defs/TraceId"
            },
            "span_id": {
              "$ref": "urn:hint:schema:v0.2:common#/$defs/SpanId"
            },
            "parent_span_id": {
              "$ref": "urn:hint:schema:v0.2:common#/$defs/SpanId"
            },
            "parent_observation_id": {
              "$ref": "urn:hint:schema:v0.2:common#/$defs/OpaqueId"
            },
            "task_family_id": {
              "$ref": "urn:hint:schema:v0.2:common#/$defs/OpaqueId",
              "description": "The task family that the run declared explicitly (HINT_TASK_FAMILY); a declaration, not a classification. The same derivation as the eval report task_family_ref."
            },
            "call_ref": {
              "$ref": "urn:hint:schema:v0.2:common#/$defs/OpaqueId",
              "description": "The opaque identity of one model call, shared by its MODEL_CALL record and its terminal USAGE record; set only when the source gives an exact call identity (draft v0.2, C7B-E)."
            },
            "run_ref": {
              "$ref": "urn:hint:schema:v0.2:common#/$defs/OpaqueId",
              "description": "The opaque reference of the one agent run that produced the record (the eval-report trial reference of the run); every record of the run carries it, and a model ledger binds to it (draft v0.2)."
            }
          },
          "dependentRequired": {
            "task_family_id": [
              "task_id"
            ]
          }
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Target"
          }
        },
        "outcome": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "success",
                "failure",
                "denied",
                "cancelled",
                "unknown"
              ]
            },
            "exit_code": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "status"
          ]
        },
        "size": {
          "allOf": [
            {
              "$ref": "urn:hint:schema:v0.2:common#/$defs/Quantity"
            },
            {
              "properties": {
                "unit": {
                  "enum": [
                    "bytes",
                    "tokens"
                  ]
                }
              }
            }
          ]
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "input_tokens": {
              "allOf": [
                {
                  "$ref": "urn:hint:schema:v0.2:common#/$defs/Quantity"
                },
                {
                  "properties": {
                    "unit": {
                      "const": "tokens"
                    }
                  }
                }
              ]
            },
            "output_tokens": {
              "allOf": [
                {
                  "$ref": "urn:hint:schema:v0.2:common#/$defs/Quantity"
                },
                {
                  "properties": {
                    "unit": {
                      "const": "tokens"
                    }
                  }
                }
              ]
            },
            "cache_read_tokens": {
              "allOf": [
                {
                  "$ref": "urn:hint:schema:v0.2:common#/$defs/Quantity"
                },
                {
                  "properties": {
                    "unit": {
                      "const": "tokens"
                    }
                  }
                }
              ]
            },
            "cache_write_tokens": {
              "allOf": [
                {
                  "$ref": "urn:hint:schema:v0.2:common#/$defs/Quantity"
                },
                {
                  "properties": {
                    "unit": {
                      "const": "tokens"
                    }
                  }
                }
              ]
            },
            "reasoning_tokens": {
              "allOf": [
                {
                  "$ref": "urn:hint:schema:v0.2:common#/$defs/Quantity"
                },
                {
                  "properties": {
                    "unit": {
                      "const": "tokens"
                    }
                  }
                }
              ]
            }
          },
          "required": [
            "input_tokens",
            "output_tokens"
          ]
        },
        "command_class": {
          "type": "string",
          "enum": [
            "READ",
            "WRITE",
            "SEARCH",
            "LIST",
            "TEST",
            "BUILD",
            "VCS",
            "PACKAGE",
            "NETWORK",
            "MIXED",
            "UNKNOWN"
          ]
        },
        "mutation_attribution": {
          "type": "string",
          "enum": [
            "none",
            "inferred",
            "exact"
          ]
        },
        "content_delivery": {
          "type": "string",
          "enum": [
            "full",
            "partial",
            "unknown"
          ]
        },
        "coordination": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sender": {
              "$ref": "urn:hint:schema:v0.2:common#/$defs/OpaqueId"
            },
            "recipient": {
              "$ref": "urn:hint:schema:v0.2:common#/$defs/OpaqueId"
            },
            "owning_repo": {
              "$ref": "urn:hint:schema:v0.2:common#/$defs/OpaqueId"
            },
            "request_id": {
              "$ref": "urn:hint:schema:v0.2:common#/$defs/OpaqueId"
            },
            "wait_evidence": {
              "type": "string",
              "enum": [
                "blocking_wait_observed",
                "reply_only",
                "none"
              ]
            },
            "conflict_ids": {
              "type": "array",
              "items": {
                "$ref": "urn:hint:schema:v0.2:common#/$defs/OpaqueId"
              },
              "uniqueItems": true
            },
            "concurrent_scope": {
              "type": "array",
              "items": {
                "$ref": "urn:hint:schema:v0.2:common#/$defs/OpaqueId"
              },
              "uniqueItems": true
            }
          }
        },
        "missing": {
          "type": "array",
          "items": {
            "$ref": "urn:hint:schema:v0.2:common#/$defs/FieldName"
          },
          "uniqueItems": true
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source_event_id": {
              "$ref": "urn:hint:schema:v0.2:common#/$defs/OpaqueId"
            },
            "captured_at": {
              "$ref": "urn:hint:schema:v0.2:common#/$defs/Timestamp"
            },
            "valid_from": {
              "$ref": "urn:hint:schema:v0.2:common#/$defs/Timestamp"
            },
            "valid_to": {
              "$ref": "urn:hint:schema:v0.2:common#/$defs/Timestamp"
            },
            "transformations": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "step": {
                    "type": "string",
                    "enum": [
                      "normalize",
                      "redact",
                      "coarsen",
                      "aggregate",
                      "time_correction"
                    ]
                  },
                  "tool": {
                    "type": "string",
                    "enum": [
                      "hint-cli",
                      "hint-server",
                      "other"
                    ]
                  },
                  "version": {
                    "$ref": "urn:hint:schema:v0.2:common#/$defs/SemVer"
                  }
                },
                "required": [
                  "step",
                  "tool",
                  "version"
                ]
              }
            }
          },
          "required": [
            "captured_at"
          ]
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "description": "A measurement of context that HINT delivered to the agent (v0.2). One tool call can have one record per stage and action; counters are derived from these records.",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "deliver",
                "expand",
                "retrieve_original"
              ]
            },
            "stage": {
              "type": "string",
              "enum": [
                "raw_tool_output",
                "delivered_context"
              ],
              "description": "Two stages of one call are two measurements of the same call, not two calls."
            },
            "artifact_id": {
              "$ref": "urn:hint:schema:v0.2:common#/$defs/OpaqueId",
              "description": "The immutable context artifact: snapshot, index and the actual input."
            },
            "ref_id": {
              "$ref": "urn:hint:schema:v0.2:common#/$defs/OpaqueId",
              "description": "The expandable reference that was used or returned."
            },
            "snapshot_id": {
              "$ref": "urn:hint:schema:v0.2:common#/$defs/OpaqueId"
            },
            "policy_state": {
              "type": "string",
              "enum": [
                "enabled",
                "disabled",
                "not_applicable",
                "unknown"
              ]
            },
            "policy_ref": {
              "$ref": "urn:hint:schema:v0.2:common#/$defs/OpaqueId",
              "description": "Project reference of the full context policy identity (id, version, digest)."
            },
            "freshness": {
              "type": "string",
              "enum": [
                "current",
                "stale",
                "unknown"
              ]
            },
            "result": {
              "type": "string",
              "enum": [
                "delivered",
                "refused_stale",
                "missing",
                "error"
              ]
            },
            "bytes": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "description": "UTF-8 bytes of the payload actually returned, before the transport envelope; null when unknown."
            },
            "omitted": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "description": "Details left out by the budget; null when unknown."
            },
            "tokens": {
              "type": "object",
              "additionalProperties": false,
              "description": "An estimate, never observed model usage.",
              "properties": {
                "value": {
                  "type": "integer",
                  "minimum": 0
                },
                "estimator": {
                  "type": "string",
                  "enum": [
                    "bytes-div-4",
                    "utf8-chars-div-4"
                  ],
                  "description": "A HINT token estimator; the list grows with the schema version."
                },
                "estimator_version": {
                  "type": "string",
                  "pattern": "^[0-9]{1,4}(\\.[0-9]{1,4}){0,2}$"
                },
                "label": {
                  "const": "estimate"
                }
              },
              "required": [
                "value",
                "estimator",
                "estimator_version",
                "label"
              ]
            },
            "repeat_of": {
              "$ref": "urn:hint:schema:v0.2:common#/$defs/OpaqueId",
              "description": "The artifact of an earlier retrieval of the exact same target and snapshot; never set by time."
            }
          },
          "required": [
            "action",
            "stage",
            "policy_state",
            "result",
            "bytes"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "policy_state": {
                    "const": "enabled"
                  }
                }
              },
              "then": {
                "required": [
                  "policy_ref"
                ]
              },
              "else": {
                "not": {
                  "required": [
                    "policy_ref"
                  ]
                }
              }
            },
            {
              "if": {
                "properties": {
                  "result": {
                    "const": "refused_stale"
                  }
                }
              },
              "then": {
                "properties": {
                  "freshness": {
                    "const": "stale"
                  }
                },
                "required": [
                  "freshness"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "result": {
                    "const": "delivered"
                  }
                }
              },
              "then": {
                "required": [
                  "artifact_id",
                  "snapshot_id"
                ]
              }
            }
          ]
        },
        "request_kind": {
          "type": "string",
          "enum": [
            "primary",
            "title",
            "compaction",
            "generate"
          ],
          "description": "The kind of a model call on its MODEL_CALL record and on its terminal USAGE record (draft v0.2, C7B-E)."
        },
        "collection": {
          "$ref": "#/$defs/Collection"
        },
        "model_ledger": {
          "$ref": "#/$defs/ModelLedger"
        }
      },
      "required": [
        "observation_id",
        "class",
        "op",
        "source",
        "source_id",
        "precision",
        "time",
        "outcome",
        "missing",
        "provenance"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "watcher"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "properties": {
              "op": {
                "const": "FILE_MUTATION"
              },
              "mutation_attribution": {
                "enum": [
                  "none",
                  "inferred"
                ]
              }
            },
            "required": [
              "mutation_attribution"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "FILE_MUTATION"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "required": [
              "mutation_attribution"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "shell_parser"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "properties": {
              "precision": {
                "enum": [
                  "inferred",
                  "unknown"
                ]
              },
              "content_delivery": {
                "enum": [
                  "partial",
                  "unknown"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "READ"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "required": [
              "content_delivery"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "USAGE"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "required": [
              "usage"
            ]
          }
        },
        {
          "if": {
            "not": {
              "properties": {
                "op": {
                  "const": "USAGE"
                }
              },
              "required": [
                "op"
              ]
            }
          },
          "then": {
            "not": {
              "required": [
                "usage"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "EXECUTE"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "required": [
              "command_class"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "enum": [
                  "DELEGATE",
                  "REQUEST",
                  "RESPONSE",
                  "WAIT"
                ]
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "required": [
              "coordination"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "WAIT"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "properties": {
              "coordination": {
                "properties": {
                  "wait_evidence": {
                    "const": "blocking_wait_observed"
                  }
                },
                "required": [
                  "wait_evidence"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "request_kind"
            ]
          },
          "then": {
            "properties": {
              "op": {
                "enum": [
                  "MODEL_CALL",
                  "USAGE"
                ]
              }
            },
            "required": [
              "op"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "MODEL_CALL"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "required": [
              "request_kind"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "coordination"
                  ]
                },
                {
                  "required": [
                    "targets"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "correlation": {
                "required": [
                  "call_ref"
                ]
              }
            },
            "required": [
              "correlation"
            ]
          },
          "then": {
            "required": [
              "request_kind"
            ]
          }
        },
        {
          "if": {
            "required": [
              "collection"
            ]
          },
          "then": {
            "properties": {
              "op": {
                "const": "SESSION"
              }
            },
            "required": [
              "op"
            ]
          }
        },
        {
          "if": {
            "required": [
              "context"
            ]
          },
          "then": {
            "properties": {
              "op": {
                "enum": [
                  "DISCOVER",
                  "READ"
                ]
              },
              "correlation": {
                "required": [
                  "tool_call_id"
                ]
              }
            },
            "required": [
              "correlation"
            ]
          }
        },
        {
          "if": {
            "required": [
              "model_ledger"
            ]
          },
          "then": {
            "properties": {
              "op": {
                "const": "USAGE"
              },
              "correlation": {
                "required": [
                  "run_ref",
                  "task_id",
                  "task_family_id"
                ]
              }
            },
            "required": [
              "op",
              "correlation",
              "usage"
            ]
          }
        }
      ]
    },
    "Metric": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metric_id": {
          "$ref": "urn:hint:schema:v0.2:common#/$defs/OpaqueId"
        },
        "class": {
          "type": "string",
          "enum": [
            "derived",
            "estimate"
          ]
        },
        "metric": {
          "$ref": "urn:hint:schema:v0.2:common#/$defs/Metric"
        },
        "unit": {
          "$ref": "urn:hint:schema:v0.2:common#/$defs/Unit"
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "task",
                "session",
                "turn",
                "repository"
              ]
            },
            "id": {
              "$ref": "urn:hint:schema:v0.2:common#/$defs/OpaqueId"
            }
          },
          "required": [
