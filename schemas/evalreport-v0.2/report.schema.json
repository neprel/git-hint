{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hint:schema:evalreport:v0.2:report",
  "title": "HINT eval result report v0.1",
  "description": "Minimized results of local eval trials. Separate from the HINT v0.1 documents: it carries no task text, code, path, command, log, content digest or local identifier. Every reference is a project-scoped opaque value derived with the project key. Unknown is null, never zero. A local qualification state is the client's claim, with its policy name.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "report_version": {
      "type": "string",
      "pattern": "^0\\.2\\.(0|[1-9][0-9]*)$"
    },
    "report_id": {
      "$ref": "#/$defs/Ref"
    },
    "project_namespace": {
      "$ref": "#/$defs/Ref"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": ":00:00Z$",
      "description": "Hour resolution."
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": {
          "const": "git-hint"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-(alpha|beta|rc|dev)(\\.[0-9]+)?)?$"
        }
      },
      "required": [
        "tool",
        "version"
      ]
    },
    "content_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 of the RFC 8785 form of the report without this field."
    },
    "trials": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/Trial"
      }
    },
    "work_units": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/WorkUnitRevision"
      },
      "description": "Declared work units (project or controlled) as immutable revisions; a report may carry them without trials."
    }
  },
  "required": [
    "report_version",
    "report_id",
    "project_namespace",
    "created_at",
    "producer",
    "content_digest",
    "trials"
  ],
  "$defs": {
    "Ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "Count": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        {
          "type": "null"
        }
      ]
    },
    "Seconds": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 31536000
        },
        {
          "type": "null"
        }
      ]
    },
    "Trial": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trial_ref": {
          "$ref": "#/$defs/Ref"
        },
        "suite_ref": {
          "$ref": "#/$defs/Ref"
        },
        "eval_ref": {
          "$ref": "#/$defs/Ref",
          "description": "One immutable eval version."
        },
        "objective_ref": {
          "$ref": "#/$defs/Ref",
          "description": "The task objective (the baseline eval), the same for the baseline and its variants. Trials of a variant pair with baseline trials only through it."
        },
        "baseline_ref": {
          "$ref": "#/$defs/Ref",
          "description": "The exact baseline eval version that this trial's eval is (equal to eval_ref) or is a variant of. Same reference scheme as eval_ref."
        },
        "environment_ref": {
          "$ref": "#/$defs/Ref",
          "description": "The task environment (image and setup) of the eval version."
        },
        "task_family_ref": {
          "$ref": "#/$defs/Ref"
        },
        "family": {
          "type": "string",
          "enum": [
            "bug_fix",
            "feature",
            "compatibility",
            "refactor"
          ]
        },
        "partition": {
          "type": "string",
          "enum": [
            "calibration",
            "held_out"
          ]
        },
        "arm": {
          "type": "string",
          "enum": [
            "baseline",
            "configuration",
            "no_change",
            "context_only",
            "refactor"
          ]
        },
        "qualification": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "policy": {
              "type": "string",
              "pattern": "^q[1-9][0-9]*$"
            },
            "state": {
              "type": "string",
              "enum": [
                "validated",
                "reproducible",
                "packaged",
                "needs_review",
                "unsupported",
                "quarantined"
              ]
            },
            "basis": {
              "const": "client_claim"
            }
          },
          "required": [
            "policy",
            "state",
            "basis"
          ]
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "agent": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "enum": [
                "nop",
                "oracle",
                "opencode"
              ]
            },
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "model_ref": {
              "$ref": "#/$defs/Ref"
            },
            "model_check": {
              "type": "string",
              "enum": [
                "verified",
                "mismatch",
                "unverified",
                "not_observed"
              ],
              "description": "Whether every forwarded model request named the selected model (HINT's proxy check); only verified supports an effective launch_parameter model."
            }
          },
          "required": [
            "name"
          ]
        },
        "runner": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "const": "harbor"
            },
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            }
          },
          "required": [
            "name",
            "version"
          ]
        },
        "outcome": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "verifier_error",
            "infrastructure_error",
            "timeout",
            "cancelled",
            "budget_exhausted"
          ]
        },
        "checks": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "check_ref": {
                "$ref": "#/$defs/Ref"
              },
              "status": {
                "type": "string",
                "enum": [
                  "pass",
                  "fail",
                  "error",
                  "not_run"
                ]
              }
            },
            "required": [
              "check_ref",
              "status"
            ]
          }
        },
        "counters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "$ref": "#/$defs/Count"
            },
            "retries": {
              "$ref": "#/$defs/Count"
            },
            "input_tokens": {
              "$ref": "#/$defs/Count"
            },
            "output_tokens": {
              "$ref": "#/$defs/Count"
            },
            "cache_tokens": {
              "$ref": "#/$defs/Count"
            },
            "wall_seconds": {
              "$ref": "#/$defs/Seconds"
            },
            "agent_seconds": {
              "$ref": "#/$defs/Seconds"
            }
          },
          "required": [
            "requests",
            "retries",
            "input_tokens",
            "output_tokens",
            "cache_tokens",
            "wall_seconds",
            "agent_seconds"
          ]
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_requests": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "max_seconds": {
              "type": "integer",
              "minimum": 1
            },
            "stop_reason": {
              "type": "string",
              "enum": [
                "completed",
                "request_limit",
                "time_limit",
                "cancelled",
                "error"
              ]
            }
          },
          "required": [
            "max_requests",
            "max_seconds",
            "stop_reason"
          ]
        },
        "context_policy": {
          "type": "object",
          "additionalProperties": false,
          "description": "The HINT context policy of the trial. enabled carries the project reference of the full identity (id, version, digest); disabled, not_applicable and unknown are different states.",
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "enabled",
                "disabled",
                "not_applicable",
                "unknown"
              ]
            },
            "ref": {
              "$ref": "#/$defs/Ref"
            },
            "version": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "state"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "state": {
                    "const": "enabled"
                  }
                }
              },
              "then": {
                "required": [
                  "ref",
                  "version"
                ]
              },
              "else": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "ref"
                      ]
                    },
                    {
                      "required": [
                        "version"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        },
        "declared_changes": {
          "type": "array",
          "uniqueItems": true,
          "description": "Controls that this arm changes on purpose (the declared treatment); every other control must match its baseline for a comparison.",
          "items": {
            "type": "string",
            "enum": [
              "agent_version",
              "model",
              "runner_version",
              "budget",
              "context_policy",
              "harness_settings"
            ]
          }
        },
        "observed_config_refs": {
          "type": "array",
          "uniqueItems": true,
          "description": "Project references of actual run overrides (observed, never a replacement of the immutable eval).",
          "items": {
            "$ref": "#/$defs/Ref"
          }
        },
        "source_task_id": {
          "$ref": "#/$defs/Ref",
          "description": "The task that the orchestrator declared for the agent run the eval came from: the same opaque ID as the activity correlation.task_id. Present only when the binding is unambiguous."
        }
      },
      "required": [
        "trial_ref",
        "suite_ref",
        "eval_ref",
        "task_family_ref",
        "family",
        "partition",
        "arm",
        "qualification",
        "attempt",
        "agent",
        "runner",
        "outcome",
        "checks",
        "counters",
        "budget",
        "context_policy"
      ]
    },
    "VersionState": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "known"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            }
          },
          "required": [
            "state",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "not_applicable",
                "unknown"
              ]
            }
          },
          "required": [
            "state"
          ]
        }
      ]
    },
    "RefState": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "known"
            },
            "ref": {
              "$ref": "#/$defs/Ref"
            }
          },
          "required": [
            "state",
            "ref"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "unknown"
            }
          },
          "required": [
            "state"
          ]
        }
      ]
    },
    "Configuration": {
      "description": "The canonical effective configuration (the same form and derivations as HINT v0.2 sources[].configuration).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "enum": [
                "opencode",
                "claude-code",
                "codex",
                "nop",
                "oracle",
                "other",
                "none"
              ]
            },
            "version": {
              "$ref": "#/$defs/VersionState"
            }
          },
          "required": [
            "name",
            "version"
          ]
        },
        "model": {
          "$ref": "#/$defs/ModelState"
        },
        "harness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "harbor",
                "direct",
                "other"
              ]
            },
            "version": {
              "$ref": "#/$defs/VersionState"
            }
          },
          "required": [
            "kind",
            "version"
          ]
        },
        "context_policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "enabled",
                "disabled",
                "not_applicable",
                "unknown"
              ]
            },
            "ref": {
              "$ref": "#/$defs/Ref"
            },
            "version": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "state"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "state": {
                    "const": "enabled"
                  }
                }
              },
              "then": {
                "required": [
                  "ref",
                  "version"
                ]
              },
              "else": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "ref"
                      ]
                    },
                    {
                      "required": [
                        "version"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        },
        "config_refs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "known",
                "unknown"
              ]
            },
            "refs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Ref"
              },
              "uniqueItems": true,
              "maxItems": 100
            }
          },
          "required": [
            "state"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "state": {
                    "const": "known"
                  }
                }
              },
              "then": {
                "required": [
                  "refs"
                ]
              },
              "else": {
                "not": {
                  "required": [
                    "refs"
                  ]
                }
              }
            }
          ]
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "description": "The request and time limits of the run (both essential for comparison).",
          "properties": {
            "max_requests": {
              "$ref": "#/$defs/Limit"
            },
            "max_seconds": {
              "$ref": "#/$defs/Limit"
            }
          },
          "required": [
            "max_requests",
            "max_seconds"
          ]
        },
        "declared": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model": {
              "$ref": "#/$defs/RefState"
            },
            "context_policy_ref": {
              "$ref": "#/$defs/Ref"
            }
          }
        }
      },
      "required": [
        "agent",
        "model",
        "harness",
        "context_policy",
        "config_refs",
        "budget"
      ]
    },
    "Attempt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attempt_ref": {
          "$ref": "#/$defs/Ref"
        },
        "task_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "uniqueItems": true,
          "maxItems": 1000,
          "description": "Explicit member tasks (the same IDs as HINT activity task IDs)."
        },
        "outcome": {
          "type": "string",
          "enum": [
            "open",
            "completed",
            "failed",
            "abandoned"
          ]
        },
        "closure": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "validated",
                "not_validated",
                "unknown"
              ]
            },
            "validation_task_id": {
              "$ref": "#/$defs/Ref"
            },
            "validation_ref": {
              "$ref": "#/$defs/Ref"
            },
            "reason": {
              "type": "string",
              "enum": [
                "checks_passed",
                "validation_task_passed",
                "not_validated",
                "trial_failed",
                "trial_error",
                "incomplete_checks",
                "not_qualified",
                "no_validation"
              ]
            }
          },
          "required": [
            "state"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "state": {
                    "const": "validated"
                  }
                }
              },
              "then": {
                "anyOf": [
                  {
                    "required": [
                      "validation_task_id"
                    ]
                  },
                  {
                    "required": [
                      "validation_ref"
                    ]
                  }
                ]
              }
            }
          ]
        },
        "application_change_set": {
          "oneOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ],
          "description": "The declared change_set document of a realized completion; null for failed, abandoned, open and no-change attempts."
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "$ref": "#/$defs/Count"
            },
            "input_tokens": {
              "$ref": "#/$defs/Count"
            },
            "output_tokens": {
              "$ref": "#/$defs/Count"
            },
            "cache_tokens": {
              "$ref": "#/$defs/Count"
            }
          },
          "required": [
            "requests",
            "input_tokens",
            "output_tokens",
            "cache_tokens"
          ]
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tasks": {
              "type": "integer",
              "minimum": 0
            },
            "tasks_with_complete_usage": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "tasks",
            "tasks_with_complete_usage"
          ]
        },
        "late_tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "uniqueItems": true,
          "maxItems": 1000,
          "description": "Member tasks with activity after closure (the unit is stale for cost)."
        },
        "trial_ref": {
          "oneOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ],
          "description": "Controlled attempts: the trial (also the validation reference)."
        },
        "trial_outcome": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "passed",
                "failed",
                "verifier_error",
                "infrastructure_error",
                "timeout",
                "cancelled",
                "budget_exhausted"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "model_check": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "verified",
                "mismatch",
                "unverified",
                "not_observed"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "usage_provenance": {
          "type": "string",
          "enum": [
            "harness_reported",
            "activity_usage",
            "unknown"
          ],
          "description": "Where the attempt's token counts come from; null counts stay null."
        },
        "checks": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mandatory": {
                  "type": "integer",
                  "minimum": 0
                },
                "present": {
                  "type": "integer",
                  "minimum": 0
                },
                "passed": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "mandatory",
                "present",
                "passed"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "qualification": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "validated",
                "reproducible",
                "packaged",
                "needs_review",
                "unsupported",
                "quarantined"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "ordinal": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            {
              "type": "null"
            }
          ],
          "description": "Controlled attempts: the planned attempt slot (1..planned_attempts)."
        }
      },
      "required": [
        "attempt_ref",
        "task_ids",
        "outcome",
        "closure",
        "application_change_set",
        "usage",
        "coverage",
        "usage_provenance"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "closure": {
                "properties": {
                  "state": {
                    "const": "validated"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "WorkUnitRevision": {
      "description": "One immutable revision of a declared work unit. scope is frozen at start (scope_digest: SHA-256 of its RFC 8785 form); predecessor is the revision_digest of revision - 1 (null for revision 1); revision_digest is the SHA-256 of the RFC 8785 form of the revision without revision_digest. A declaration of work, never a confirmed effect.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unit_ref": {
          "$ref": "#/$defs/Ref"
        },
        "origin": {
          "type": "string",
          "enum": [
            "project",
            "controlled"
          ]
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "declared_at": {
              "type": "string",
              "format": "date-time",
              "pattern": ":00:00Z$"
            },
            "plan": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "recommendation_set_id": {
                      "$ref": "#/$defs/Ref"
                    },
                    "plan_id": {
                      "$ref": "#/$defs/Ref"
                    }
                  },
                  "required": [
                    "recommendation_set_id",
                    "plan_id"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "objective_ref": {
              "oneOf": [
                {
                  "$ref": "#/$defs/Ref"
                },
                {
                  "type": "null"
                }
              ]
            },
            "base_snapshots": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Ref"
              },
              "uniqueItems": true,
              "maxItems": 100
            },
            "family_ref": {
              "$ref": "#/$defs/Ref"
            },
            "configuration": {
              "$ref": "#/$defs/Configuration"
            },
            "environment_ref": {
              "oneOf": [
                {
                  "$ref": "#/$defs/Ref"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Controlled units: the eval environment (image, setup, dependency locks) of the frozen version."
            },
            "run_ref": {
              "oneOf": [
                {
                  "$ref": "#/$defs/Ref"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Controlled units: the immutable run manifest, persisted before the first attempt."
            },
            "eval_ref": {
              "oneOf": [
                {
                  "$ref": "#/$defs/Ref"
                },
                {
                  "type": "null"
                }
              ]
            },
            "baseline_ref": {
              "oneOf": [
                {
                  "$ref": "#/$defs/Ref"
                },
                {
                  "type": "null"
                }
              ]
            },
            "arm": {
              "oneOf": [
                {
                  "type": "string",
                  "enum": [
                    "baseline",
                    "configuration",
                    "no_change",
                    "context_only",
                    "refactor"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "planned_attempts": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "declared_at",
            "plan",
            "objective_ref",
            "base_snapshots",
            "family_ref",
            "configuration"
          ]
        },
        "scope_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "predecessor": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "open",
            "closed"
          ]
        },
        "attempts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Attempt"
          },
          "maxItems": 1000
        },
        "declared_by": {
          "const": "user"
        },
        "revision_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "unit_ref",
        "origin",
        "scope",
        "scope_digest",
        "revision",
        "predecessor",
        "state",
        "attempts",
        "declared_by",
        "revision_digest"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "origin": {
                "const": "project"
              }
            }
          },
          "then": {
            "properties": {
              "scope": {
                "properties": {
                  "base_snapshots": {
                    "minItems": 1
                  },
                  "environment_ref": {
                    "type": "null"
                  },
                  "run_ref": {
                    "type": "null"
                  },
                  "eval_ref": {
                    "type": "null"
                  },
                  "baseline_ref": {
                    "type": "null"
                  },
                  "arm": {
                    "type": "null"
                  },
                  "planned_attempts": {
                    "type": "null"
                  }
                },
                "required": [
                  "environment_ref",
                  "run_ref",
                  "eval_ref",
                  "baseline_ref",
                  "arm",
                  "planned_attempts"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "origin": {
                "const": "controlled"
              }
            }
          },
          "then": {
            "properties": {
              "scope": {
                "properties": {
                  "plan": {
                    "type": "null"
                  },
                  "objective_ref": {
                    "$ref": "#/$defs/Ref"
                  },
                  "environment_ref": {
                    "$ref": "#/$defs/Ref"
                  },
                  "run_ref": {
                    "$ref": "#/$defs/Ref"
                  },
                  "eval_ref": {
                    "$ref": "#/$defs/Ref"
                  },
                  "baseline_ref": {
                    "$ref": "#/$defs/Ref"
                  },
                  "arm": {
                    "type": "string"
                  },
                  "planned_attempts": {
                    "type": "integer"
                  }
                },
                "required": [
                  "environment_ref",
                  "run_ref",
                  "eval_ref",
                  "baseline_ref",
                  "arm",
                  "planned_attempts"
                ]
              },
              "attempts": {
                "items": {
                  "properties": {
                    "ordinal": {
                      "type": "integer"
                    },
                    "trial_ref": {
                      "$ref": "#/$defs/Ref"
                    },
                    "trial_outcome": {
                      "type": "string"
                    },
                    "model_check": {
                      "type": "string"
                    },
                    "checks": {
                      "type": "object"
                    },
                    "qualification": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "ordinal",
                    "trial_ref",
                    "trial_outcome",
                    "model_check",
                    "checks",
                    "qualification"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "Limit": {
      "description": "A run limit: known with its value, unbounded when the run had explicitly no such limit, unknown otherwise. An absent value is never unbounded.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "known"
            },
            "value": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "state",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "unbounded",
                "unknown"
              ]
            }
          },
          "required": [
            "state"
          ]
        }
      ]
    },
    "ModelState": {
      "description": "The model of the run: known with its provenance (launch_intent: the constructed selection before any check — never the effective model by itself; launch_parameter: the selection that constructed the launch, enforced and checked; agent_reported: reported by the agent) or unknown. A user's declaration alone is never effective (see declared).",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "known"
            },
            "ref": {
              "$ref": "#/$defs/Ref"
            },
            "provenance": {
              "type": "string",
              "enum": [
                "launch_intent",
                "launch_parameter",
                "agent_reported"
              ]
            }
          },
          "required": [
            "state",
            "ref",
            "provenance"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "unknown"
            }
          },
          "required": [
            "state"
          ]
        }
      ]
    }
  }
}
