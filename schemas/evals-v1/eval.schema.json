{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hint:local:evals:v1:eval",
  "title": "HINT local eval version",
  "description": "One immutable eval version: base state, instruction, environment, hidden verifier and qualification evidence. A content change makes a new version and invalidates dependent qualifications.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "Generator": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "maxLength": 100}, "version": {"type": "string", "maxLength": 64},
        "model": {"type": "string", "maxLength": 200}, "inputs": {"type": "array", "items": {"$ref": "urn:hint:local:evals:v1:common#/$defs/Digest"}},
        "output": {"$ref": "urn:hint:local:evals:v1:common#/$defs/Digest"}, "requests": {"type": "integer", "minimum": 0}
      },
      "required": ["name", "version", "inputs", "output", "requests"]
    }
  },
  "properties": {
    "record": {"const": "eval"},
    "manifest_version": {"const": 1},
    "eval_id": {"$ref": "urn:hint:local:evals:v1:common#/$defs/EvalID", "x-hint-class": "local"},
    "version": {"type": "integer", "minimum": 1, "x-hint-class": "local"},
    "previous": {"oneOf": [{"$ref": "urn:hint:local:evals:v1:common#/$defs/EvalRef"}, {"type": "null"}], "x-hint-class": "local"},
    "created_at": {"$ref": "urn:hint:local:evals:v1:common#/$defs/Timestamp", "x-hint-class": "local"},
    "episode_id": {"$ref": "urn:hint:local:evals:v1:common#/$defs/EpisodeID", "x-hint-class": "local"},
    "family": {"$ref": "urn:hint:local:evals:v1:common#/$defs/Family", "x-hint-class": "reportable"},
    "repositories": {
      "type": "array", "minItems": 1, "x-hint-class": "local",
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "repo": {"type": "string", "minLength": 1, "maxLength": 200},
          "base_tree": {"$ref": "urn:hint:local:evals:v1:common#/$defs/Digest"},
          "base_archive": {"$ref": "urn:hint:local:evals:v1:common#/$defs/Digest"},
          "result_tree": {"$ref": "urn:hint:local:evals:v1:common#/$defs/Digest"}
        },
        "required": ["repo", "base_tree", "base_archive"]
      }
    },
    "instruction": {"$ref": "urn:hint:local:evals:v1:common#/$defs/Digest", "x-hint-class": "sensitive"},
    "requirements": {
      "type": "array", "minItems": 1, "x-hint-class": "sensitive",
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "req_id": {"type": "string", "pattern": "^R[1-9][0-9]{0,2}$"},
          "kind": {"type": "string", "enum": ["behavior", "constraint", "interface", "preserve", "structure"]},
          "origin": {"type": "string", "enum": ["request", "correction", "result_test", "result_state", "existing_test"]},
          "text": {"$ref": "urn:hint:local:evals:v1:common#/$defs/Digest"},
          "evidence": {"type": "array", "items": {"$ref": "urn:hint:local:evals:v1:common#/$defs/SourceLocation"}},
          "checks": {"type": "array", "items": {"type": "string", "pattern": "^C[1-9][0-9]{0,2}$"}, "uniqueItems": true},
          "tests": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9._/+-]+::[A-Za-z_][A-Za-z0-9_]*$"}, "uniqueItems": true,
            "description": "The tests of the checks that verify this requirement; absent means the whole check."},
          "generator": {"$ref": "#/$defs/Generator", "description": "Provenance of a model mapping."},
          "source": {"$ref": "urn:hint:local:evals:v1:common#/$defs/Digest", "description": "The original request or correction that this atomic requirement was split from (kept unchanged)."},
          "mapping": {"type": "string", "enum": ["construction", "model", "user", "none"],
            "description": "How the requirement-to-check link was made: by construction (existing tests, derived API check), by the local model (not independent), by the user, or not at all. Absent means construction (manifests before G10-3)."}
        },
        "required": ["req_id", "kind", "origin", "text", "evidence", "checks"],
        "if": {"properties": {"mapping": {"const": "none"}}, "required": ["mapping"]},
        "then": {"properties": {"checks": {"maxItems": 0}, "tests": {"maxItems": 0}}},
        "else": {"properties": {"checks": {"minItems": 1}}}
      }
    },
    "verifier": {
      "type": "object", "additionalProperties": false, "x-hint-class": "sensitive",
      "properties": {
        "archive": {"$ref": "urn:hint:local:evals:v1:common#/$defs/Digest", "description": "The hidden tests directory; never in the agent image."},
        "checks": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "check_id": {"type": "string", "pattern": "^C[1-9][0-9]{0,2}$"},
              "origin": {"type": "string", "enum": ["existing_test", "result_test", "generated"]},
              "tests": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9._/+-]+::[A-Za-z_][A-Za-z0-9_]*$"}, "uniqueItems": true,
                "description": "The tests that the check requires to run (C1: each must pass)."},
              "generator": {"$ref": "#/$defs/Generator"}
            },
            "required": ["check_id", "origin"]
          }
        }
      },
      "required": ["archive", "checks"]
    },
    "reference": {"$ref": "urn:hint:local:evals:v1:common#/$defs/Digest", "x-hint-class": "sensitive", "description": "Reference patch: private evaluator evidence, not proof of correctness."},
    "environment": {
      "type": "object", "additionalProperties": false, "x-hint-class": "local",
      "properties": {
        "image": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*(:[A-Za-z0-9._-]+)?@sha256:[0-9a-f]{64}$"},
        "setup": {"$ref": "urn:hint:local:evals:v1:common#/$defs/Digest"},
        "workdir": {"type": "string", "pattern": "^/[A-Za-z0-9._/-]*$"},
        "test_command": {"type": "string", "enum": ["tests/test.sh"]}
      },
      "required": ["image", "workdir", "test_command"]
    },
    "dependencies": {"type": "array", "items": {"$ref": "urn:hint:local:evals:v1:common#/$defs/EvalRef"}, "uniqueItems": true, "x-hint-class": "local"},
    "state": {"$ref": "urn:hint:local:evals:v1:common#/$defs/State", "x-hint-class": "reportable"},
    "reasons": {"type": "array", "items": {"$ref": "urn:hint:local:evals:v1:common#/$defs/Reason"}, "uniqueItems": true, "x-hint-class": "local"},
    "context": {
      "type": "array",
      "maxItems": 200,
      "x-hint-class": "sensitive",
      "description": "Parts of the request or corrections that the user confirmed as context (no requirement). Only a user can confirm context.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {"$ref": "urn:hint:local:evals:v1:common#/$defs/Digest"},
          "source": {"$ref": "urn:hint:local:evals:v1:common#/$defs/Digest", "description": "The original request or correction."},
          "by": {"const": "user"}
        },
        "required": ["text", "source", "by"]
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "x-hint-class": "local",
      "description": "An executable variant of a validated baseline eval with the same task objective (E14): what changed and how the reference was obtained.",
      "properties": {
        "arm": {"type": "string", "enum": ["context_only", "refactor"]},
        "of": {"type": "string", "pattern": "^ev-[0-9a-f]{16}@[1-9][0-9]*$", "description": "The baseline eval version."},
        "of_digest": {"$ref": "urn:hint:local:evals:v1:common#/$defs/Digest", "description": "Digest of the baseline record."},
        "inputs": {"type": "array", "items": {"$ref": "urn:hint:local:evals:v1:common#/$defs/Digest"}, "description": "context_only: a tree of the context files only (path, mode, content); refactor: the refactored repository tree."},
        "reference": {"type": "string", "enum": ["original", "reconstructed_patch", "missing"], "description": "original: the baseline's change applies unchanged; reconstructed_patch: the change ported onto the refactored base with a strict patch; missing: no reference (never validated)."},
        "plan": {"type": "object", "additionalProperties": false, "x-hint-class": "local", "description": "The frozen plan binding of a refactor variant: a client-declared association of the variant's input tree (the captured after state) with a work unit attempt and its plan.", "properties": {"recommendation_set_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"}, "set_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "plan_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"}, "unit_ref": {"type": "string", "pattern": "^[0-9a-f]{32}$"}, "revision": {"type": "integer", "minimum": 1}, "attempt_ref": {"type": "string", "pattern": "^[0-9a-f]{32}$"}, "after_snapshot_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"}, "after_tree": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}, "required": ["recommendation_set_id", "set_digest", "plan_id", "unit_ref", "revision", "attempt_ref", "after_snapshot_id", "after_tree"]}
      },
      "required": ["arm", "of", "of_digest", "inputs", "reference"]
    },
    "alternatives": {
      "type": "array",
      "maxItems": 8,
      "x-hint-class": "local",
      "description": "Existing alternative solutions that someone states are correct. Qualification runs each one; none is generated.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tree": {"$ref": "urn:hint:local:evals:v1:common#/$defs/Digest"},
          "source": {"type": "string", "pattern": "^(user|episode:ep-[0-9a-f]{16})$", "description": "Where the solution came from."},
          "claimed_by": {"type": "string", "enum": ["user"], "description": "Who claims that it is independent of the reference; absent: nobody."}
        },
        "required": ["tree", "source"]
      }
    },
    "qualification": {
      "type": "object", "additionalProperties": false, "x-hint-class": "reportable",
      "properties": {
        "policy": {"type": "string", "pattern": "^q[1-9][0-9]*$"},
        "checks": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "name": {"type": "string", "enum": ["base_fails", "reference_passes", "repeatable", "near_miss_fails", "alternative_passes", "isolation", "leak_probe", "forgery_probe", "requirement_coverage"]},
              "status": {"type": "string", "enum": ["pass", "fail", "missing", "not_applicable"]},
              "runs": {"type": "integer", "minimum": 0},
              "independent": {"type": "boolean"},
              "claimed_by": {"type": "string", "pattern": "^[a-z_]+(,[a-z_]+)*$", "description": "Who claims that the alternatives are independent of the reference (a claim, not an observation)."},
              "evidence": {"type": "array", "items": {"$ref": "urn:hint:local:evals:v1:common#/$defs/Digest"}}
            },
            "required": ["name", "status", "runs"]
          }
        },
        "requirements": {
          "type": "array",
          "description": "Per requirement: pass when its mapped tests pass in every reference run and (for requested behavior) at least one fails on the base.",
          "items": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "req_id": {"type": "string", "pattern": "^R[1-9][0-9]{0,2}$"},
              "status": {"type": "string", "enum": ["pass", "fail", "missing", "not_applicable"]},
              "reason": {"$ref": "urn:hint:local:evals:v1:common#/$defs/Reason"}
            },
            "required": ["req_id", "status"]
          }
        }
      },
      "required": ["policy", "checks"]
    },
    "override": {
      "oneOf": [{"type": "null"}, {
        "type": "object", "additionalProperties": false,
        "properties": {"state": {"$ref": "urn:hint:local:evals:v1:common#/$defs/State"}, "at": {"$ref": "urn:hint:local:evals:v1:common#/$defs/Timestamp"}},
        "required": ["state", "at"]
      }],
      "x-hint-class": "local", "description": "A user decision, kept apart from the automatic qualification."
    }
  },
  "required": ["record", "manifest_version", "eval_id", "version", "previous", "created_at", "episode_id", "family", "repositories", "instruction", "requirements", "verifier", "environment", "dependencies", "state", "reasons", "qualification", "override"],
  "if": {"properties": {"state": {"const": "validated"}}, "required": ["state"]},
  "then": {"properties": {"requirements": {"items": {"not": {"properties": {"mapping": {"const": "none"}}, "required": ["mapping"]}}}}}
}
