{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hint:local:evals:v1:suite",
  "title": "HINT local frozen suite",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "record": {"const": "suite"},
    "manifest_version": {"const": 1},
    "suite_id": {"$ref": "urn:hint:local:evals:v1:common#/$defs/SuiteID", "x-hint-class": "local"},
    "created_at": {"$ref": "urn:hint:local:evals:v1:common#/$defs/Timestamp", "x-hint-class": "local"},
    "qualification_policy": {"type": "string", "pattern": "^q[1-9][0-9]*$", "x-hint-class": "reportable"},
    "members": {
      "type": "array", "minItems": 1, "x-hint-class": "local",
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "eval": {"$ref": "urn:hint:local:evals:v1:common#/$defs/EvalRef"},
          "task_family": {"type": "string", "pattern": "^tf-[0-9a-f]{16}$", "description": "Related episodes, patches and derived tasks share one family."},
          "partition": {"type": "string", "enum": ["calibration", "held_out"]}
        },
        "required": ["eval", "task_family", "partition"]
      }
    }
  },
  "required": ["record", "manifest_version", "suite_id", "created_at", "qualification_policy", "members"]
}
