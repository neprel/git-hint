{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hint:local:evals:v1:trial",
  "title": "HINT local trial result",
  "description": "One attempt of one eval version under one configuration. Every attempt is kept, including failures, timeouts and cancellations, with its consumed resources.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "record": {
      "const": "trial"
    },
    "manifest_version": {
      "const": 1
    },
    "trial_id": {
      "$ref": "urn:hint:local:evals:v1:common#/$defs/TrialID",
      "x-hint-class": "reportable"
    },
    "suite_id": {
      "$ref": "urn:hint:local:evals:v1:common#/$defs/SuiteID",
      "x-hint-class": "reportable"
    },
    "eval": {
      "$ref": "urn:hint:local:evals:v1:common#/$defs/EvalRef",
      "x-hint-class": "reportable"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "x-hint-class": "reportable"
    },
    "objective": {
      "$ref": "urn:hint:local:evals:v1:common#/$defs/EvalID",
      "x-hint-class": "reportable",
      "description": "The task objective: the baseline eval ID, the same for the baseline and its variants. Trials pair only within one objective."
    },
    "context_policy": {
      "type": "object",
      "additionalProperties": false,
      "x-hint-class": "local",
      "description": "The HINT context policy of the run: the immutable canonical effective configuration (id, version, digest) when enabled; disabled, not_applicable and unknown are distinct states.",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "enabled",
            "disabled",
            "not_applicable",
            "unknown"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "digest": {
          "$ref": "urn:hint:local:evals:v1:common#/$defs/Digest"
        }
      },
      "required": [
        "state"
      ],
      "if": {
        "properties": {
          "state": {
            "const": "enabled"
          }
        }
      },
      "then": {
        "required": [
          "id",
          "version",
          "digest"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "id"
              ]
            },
            {
              "required": [
                "version"
              ]
            },
            {
              "required": [
                "digest"
              ]
            }
          ]
        }
      }
    },
    "declared_changes": {
      "type": "array",
      "uniqueItems": true,
      "x-hint-class": "reportable",
      "description": "Controls that this arm changes on purpose (the declared treatment).",
      "items": {
        "type": "string",
        "enum": [
          "agent_version",
          "model",
          "runner_version",
          "budget",
          "context_policy",
          "harness_settings"
        ]
      }
    },
    "observed_config": {
      "type": "array",
      "x-hint-class": "local",
      "description": "Actual run overrides, as observed; never a replacement of the immutable eval.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "setting_override",
              "dependency_lock"
            ]
          },
          "digest": {
            "$ref": "urn:hint:local:evals:v1:common#/$defs/Digest"
          }
        },
        "required": [
          "kind",
          "digest"
        ]
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "x-hint-class": "local",
      "description": "The immutable versions this trial ran: the baseline and the eval that ran (the baseline itself or its variant).",
      "properties": {
        "baseline": {
          "$ref": "urn:hint:local:evals:v1:common#/$defs/EvalRef"
        },
        "baseline_digest": {
          "$ref": "urn:hint:local:evals:v1:common#/$defs/Digest"
        },
        "eval_digest": {
          "$ref": "urn:hint:local:evals:v1:common#/$defs/Digest"
        }
      },
      "required": [
        "baseline",
        "baseline_digest",
        "eval_digest"
      ]
    },
    "arm": {
      "type": "string",
      "enum": [
        "baseline",
        "no_change",
        "context_only",
        "refactor",
        "configuration"
      ],
      "x-hint-class": "reportable"
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "x-hint-class": "reportable",
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "nop",
            "oracle",
            "opencode"
          ]
        },
        "version": {
          "type": "string",
          "maxLength": 64
        },
        "model": {
          "type": "string",
          "maxLength": 200
        },
        "model_check": {
          "type": "string",
          "enum": [
            "verified",
            "mismatch",
            "unverified",
            "not_observed"
          ],
          "description": "Whether every forwarded model request named the selected model (HINT's proxy check); only verified supports an effective launch_parameter model."
        }
      },
      "required": [
        "name"
      ]
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "x-hint-class": "reportable",
      "properties": {
        "name": {
          "enum": [
            "harbor",
            "hint-docker"
          ]
        },
        "version": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "started_at": {
      "$ref": "urn:hint:local:evals:v1:common#/$defs/Timestamp",
      "x-hint-class": "local"
    },
    "result_trust": {
      "$ref": "urn:hint:local:evals:v1:common#/$defs/ResultTrust",
      "x-hint-class": "reportable",
      "description": "The runner's trust of this trial over the eval's required checks; absent in older trials, read as unknown."
    },
    "outcome": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "verifier_error",
        "infrastructure_error",
        "timeout",
        "cancelled",
        "budget_exhausted"
      ],
      "x-hint-class": "reportable"
    },
    "checks": {
      "type": "array",
      "x-hint-class": "reportable",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "check_id": {
            "type": "string",
            "pattern": "^[CB][1-9][0-9]{0,2}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "error",
              "not_run"
            ]
          }
        },
        "required": [
          "check_id",
          "status"
        ]
      }
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "x-hint-class": "reportable",
      "properties": {
        "requests": {
          "$ref": "urn:hint:local:evals:v1:common#/$defs/Count"
        },
        "retries": {
          "$ref": "urn:hint:local:evals:v1:common#/$defs/Count"
        },
        "input_tokens": {
          "$ref": "urn:hint:local:evals:v1:common#/$defs/Count"
        },
        "output_tokens": {
          "$ref": "urn:hint:local:evals:v1:common#/$defs/Count"
        },
        "cache_tokens": {
          "$ref": "urn:hint:local:evals:v1:common#/$defs/Count"
        },
        "wall_seconds": {
          "$ref": "urn:hint:local:evals:v1:common#/$defs/Seconds"
        },
        "agent_seconds": {
          "$ref": "urn:hint:local:evals:v1:common#/$defs/Seconds"
        }
      },
      "required": [
        "requests",
        "input_tokens",
        "output_tokens",
        "wall_seconds"
      ]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "x-hint-class": "reportable",
      "properties": {
        "max_requests": {
          "type": "integer",
          "minimum": 1
        },
        "max_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "stop_reason": {
          "type": "string",
          "enum": [
            "completed",
            "request_limit",
            "time_limit",
            "cancelled",
            "error"
          ]
        }
      },
      "required": [
        "max_seconds",
        "stop_reason"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "urn:hint:local:evals:v1:common#/$defs/Digest"
      },
      "x-hint-class": "local"
    },
    "run_id": {
      "type": "string",
      "pattern": "^jb-[0-9a-f]{16}$",
      "x-hint-class": "local",
      "description": "The run (job) whose manifest planned this trial; set at creation, never inferred."
    },
    "plan_binding": {
      "type": "object",
      "additionalProperties": false,
      "x-hint-class": "local",
      "description": "The plan binding of the variant that ran (copied at creation from the variant record).",
      "properties": {
        "recommendation_set_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "set_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "plan_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "unit_ref": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "attempt_ref": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "after_snapshot_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "after_tree": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "recommendation_set_id",
        "set_digest",
        "plan_id",
        "unit_ref",
        "revision",
        "attempt_ref",
        "after_snapshot_id",
        "after_tree"
      ]
    }
  },
  "required": [
    "record",
    "manifest_version",
    "trial_id",
    "suite_id",
    "eval",
    "attempt",
    "arm",
    "agent",
    "runner",
    "started_at",
    "outcome",
    "checks",
    "counters",
    "budget"
  ]
}
