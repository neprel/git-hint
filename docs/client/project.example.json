{
  "format_version": 1,
  "key_id": "written by git hint init",
  "project_namespace": "written by git hint init",
  "repos": [
    { "name": "shop", "path": "." },
    { "name": "shop-web", "path": "../shop-web" }
  ],
  "server_url": "https://hint.example.org",
